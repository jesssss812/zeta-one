# Secrets: the Rho staging token and the VPN profile never enter git
.env
.env.local
*.ovpn

# Local Rho staging snapshots: reviewed before anything derived from them is committed
data/snapshots/

# The gateway's local database and the demo agents' private keys, created on first start
data/zeta.db
data/keys/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node (the site lives in site/)
node_modules/
site/dist/
site/.next/
site/.svelte-kit/
site/build/

# OS and editors
.DS_Store
.idea/
.vscode/

# Claude Code local state
.claude/settings.local.json
.claude/worktrees/
.check_pycache
