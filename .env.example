# Copy to .env and fill in. .env is gitignored and Claude Code is denied from reading it.

# Rho hackathon staging API. Staging tokens only work against this host.
RHO_API_BASE_URL=https://rhoapi.rho-staging.co/api/v1
RHO_API_TOKEN=

# The strong tier and the case review assistant (Claude).
ANTHROPIC_API_KEY=

# Jev, the cheap risk tier (docs/reference/jev.md): through OpenRouter by default, TypeSafe direct as
# the backup when OpenRouter can't be reached. OPENROUTER_API_KEY also serves the open-weight arm.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# The live gateway's risk configuration: engineered (default), jev or open_weight.
ZETA_RISK_CONFIGURATION=engineered

# The open-weight comparison arm (decision 0014): any OpenAI-compatible API, OpenRouter by default.
OPEN_WEIGHT_API_KEY=
OPEN_WEIGHT_BASE_URL=https://openrouter.ai/api/v1
OPEN_WEIGHT_MODEL=qwen/qwen3-235b-a22b-2507
# USD per million input and output tokens, e.g. 0.2,0.6; leave empty and costs show as unpriced.
OPEN_WEIGHT_PRICES=
# Or, for a model on a GPU you rent or own: its USD per hour, charged for each call's time, e.g. 0.59.
OPEN_WEIGHT_GPU_HOURLY=

# The case review's chat: a local model through Ollama's OpenAI-compatible API, so case data stays on
# this machine. Start it with `ollama serve` and `ollama pull qwen2.5:7b`.
CHAT_BASE_URL=http://127.0.0.1:11434/v1
CHAT_MODEL=qwen2.5:7b
# Or the open-weight arm's vLLM server on the rented GPU: copy OPEN_WEIGHT_BASE_URL into
# CHAT_BASE_URL and OPEN_WEIGHT_API_KEY into CHAT_API_KEY, and set CHAT_MODEL=qwen3.6-27b. The address
# decides where the case goes: pointed at that server, the chat sends it the whole case, which then
# leaves this machine; only synthetic data is used. The key, when set, is only sent as the access key.
CHAT_API_KEY=
