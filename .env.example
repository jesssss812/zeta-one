# Copy to .env and fill in. .env is gitignored and Claude Code is denied from reading it.

# Rho hackathon staging API. Staging tokens only work against this host.
RHO_API_BASE_URL=https://rhoapi.rho-staging.co/api/v1
RHO_API_TOKEN=

# TypeSafe console key for Jev, the cheap risk tier (docs/reference/jev.md).
TYPESAFE_API_KEY=
# The live gateway's risk configuration: engineered (default) or jev.
ZETA_RISK_CONFIGURATION=engineered
